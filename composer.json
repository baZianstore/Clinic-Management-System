{
  "name": "bazianstore/clinic-management-system",
  "description": "Clinic Management System web application using PHP & MySQL",
  "type": "project",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Tests\\": "tests/"
    },
    "files": []
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
